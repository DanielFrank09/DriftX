# Optional NAT traversal for networks that block direct WebRTC connections.
# Set these as SERVER-side Vercel environment variables, then redeploy.
# METERED_DOMAIN=your-app.metered.live
# METERED_API_KEY=your-private-turn-api-key
# Or supply provider-issued browser ICE credentials (prefer expiring credentials):
# TURN_ICE_SERVERS=[{"urls":"turns:your-relay.example.com:443","username":"temporary-user","credential":"temporary-password"}]
